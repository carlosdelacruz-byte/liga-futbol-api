# Los scripts de shell SIEMPRE se guardan con saltos de linea LF.
# Si viajaran con CRLF desde Windows, Render fallaria al ejecutarlos con
# "bad interpreter: /usr/bin/env bash^M".
*.sh text eol=lf

# El resto de archivos de texto, normalizados tambien a LF en el repositorio.
*.py text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
